# Copia este archivo como .env y completa los valores.
# NO subas tu .env real a repositorios públicos.

# Seguridad
SECRET_KEY=pon_aqui_un_valor_largo_aleatorio
FLASK_ADMIN_PASSWORD=pon_aqui_una_contrasena_admin_segura
ALLOW_DEV_SECRET_KEY=0

# URL pública de producción. En Render debe ser:
# https://tu-servicio.onrender.com o tu dominio propio.
PUBLIC_BASE_URL=

# Base de datos
# Recomendado para Render: PostgreSQL/Supabase.
# Si lo dejas vacío, usa SQLite local en instance/tienda.sqlite.
DATABASE_URL=

# Stripe
STRIPE_PUBLIC_KEY=pk_test_o_pk_live
STRIPE_SECRET_KEY=sk_test_o_sk_live
STRIPE_WEBHOOK_SECRET=whsec_tu_secret_del_webhook
PRECIO_IMPRESO_CENTAVOS=5555
# Estimación usada en admin si aún no escribes la comisión real del pedido.
STRIPE_FEE_PERCENT=2.9
STRIPE_FEE_FIXED_CENTAVOS=30

# Email (SMTP Gmail con contraseña de aplicación)
EMAIL_SENDER=tu_correo_remitente@gmail.com
EMAIL_PASSWORD=tu_app_password_de_gmail
ADMIN_EMAIL=tu_correo_admin@gmail.com
# Opcional/recomendado en Render para email transaccional
BREVO_API_KEY=

# Contacto público (opcional)
# WhatsApp: puedes poner +34600111222 o 34600111222
PUBLIC_WHATSAPP_PHONE=
# Instagram: URL completa
PUBLIC_INSTAGRAM_URL=

# HTTPS / proxy (producción)
# Si tu app está detrás de Nginx/Cloudflare, pon normalmente TRUSTED_PROXY_COUNT=1
TRUSTED_PROXY_COUNT=0
# Activa cookies de sesión solo por HTTPS (recomendado en producción)
SESSION_COOKIE_SECURE=0
# Redirige HTTP -> HTTPS dentro de la app (solo si ya tienes HTTPS terminado en el proxy)
ENFORCE_HTTPS=0
# HSTS (solo tiene efecto si SESSION_COOKIE_SECURE=1). Valor en segundos.
HSTS_MAX_AGE=15552000
# Límite de tamaño por petición para evitar formularios enormes accidentales o abusivos.
MAX_CONTENT_LENGTH=1000000
# El enlace de descarga del PDF y el archivo en Google Drive expiran a las 48 horas.
DRIVE_EXPIRACION_HORAS=48
PDF_DOWNLOAD_TOKEN_MAX_AGE_HOURS=48
# En Render, permite que la app limpie Drive periódicamente sin depender solo del botón manual.
DRIVE_CLEANUP_ON_REQUEST=1
DRIVE_CLEANUP_INTERVAL_SECONDS=3600

# Runtime
FLASK_DEBUG=0
PORT=5000

# Google Drive
GOOGLE_DRIVE_FOLDER_ID=
# Render recomendado: pegar el JSON completo de la cuenta de servicio en esta variable.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
# Alternativa Render si usas OAuth en vez de Service Account:
GOOGLE_DRIVE_OAUTH_CLIENT_JSON=
GOOGLE_DRIVE_TOKEN_JSON=
# Local opcional: usar archivos en secrets/
GOOGLE_DRIVE_OAUTH_CLIENT_PATH=
GOOGLE_DRIVE_TOKEN_PATH=
GOOGLE_DRIVE_CREDENTIALS_PATH=
DISABLE_GOOGLE_DRIVE=0

# OpenAI (contenido narrativo)
OPENAI_API_KEY=
# Seguridad: mantener false hasta aprobar pruebas del PDF.
# Para vender real automáticamente, cambiar a true.
OPENAI_ENABLE_REAL_ORDERS=false
MAX_OPENAI_CALLS_PER_ORDER=3
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.45
OPENAI_TIMEOUT_SEGUNDOS=120
OPENAI_MAX_OUTPUT_TOKENS=12000
MAX_REINTENTOS_BLOQUE=0
